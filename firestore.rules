/**
 * @fileoverview Firestore Security Rules for the Gopalganj Swasthya Seva app.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model where doctors data
 * is publically readable, and appointments are writable by any signed in user.
 *
 * Data Structure:
 * - /doctors/{doctorId}: Stores doctor profiles, publicly readable.
 * - /appointments/{appointmentId}: Stores appointment data.
 *
 * Key Security Decisions:
 * - Doctors can be listed and read by anyone.
 * - Users must be signed in to create appointments
 *
 * Denormalization for Authorization:
 * None. The rules rely on simple path-based access control and do not require
 * denormalization or data duplication.
 *
 * Structural Segregation:
 * Doctor profiles and appointment data are stored in separate top-level
 * collections. This simplifies list operations and avoids the need for
 * complex queries in security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants read access to anyone, allows anyone to create, but no update or delete
     * @path /doctors/{doctorId}
     * @allow (get, list)
     * @allow (create) - Any signed-in user can create a doctor profile.
     * @deny (update, delete) - Only authenticated users can create doctor profiles.
     * @principle Public read, but only authenticated users can create
     */
    match /doctors/{doctorId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Allows any signed-in user to create appointments
     * @path /appointments/{appointmentId}
     * @allow (create) - Any signed-in user can create an appointment.
     * @allow (get, list) - Any signed-in user can get and list appointments.
     * @deny (update, delete) - Appointments can only be created.
     * @principle Signed-in users can read and create appointments.
     */
    match /appointments/{appointmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}