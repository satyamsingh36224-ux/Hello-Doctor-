/**
 * @fileoverview Firestore Security Rules for Gopalganj Swasthya Seva App
 *
 * Core Philosophy:
 * This ruleset provides basic authorization for doctors and appointments.
 * All `write` operations are open, as the app is in prototyping mode to allow fast data iteration.
 *
 * Data Structure:
 * - /doctors/{doctorId}: Stores doctor profiles.
 * - /appointments/{appointmentId}: Stores appointment information.
 *
 * Key Security Decisions:
 * - In this prototype, both `doctors` and `appointments` are publicly readable.
 * - Write operations are currently open.
 * - No user listing is allowed in this prototype.
 *
 * Denormalization for Authorization:
 * Not applicable in this prototype, since all write operations are open.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read access to the `doctors` collection for all users. All write operations are open.
     * @path /doctors/{doctorId}
     * @allow (get, list): Any user can read doctor profiles.
     * @allow (create, update, delete): Any authenticated user can create, update, or delete doctor profiles.
     * @deny (create, update, delete): Not applicable, as write operations are open in prototype.
     * @principle Allows any user to read doctors information.
     */
    match /doctors/{doctorId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows read access to the `appointments` collection for all users. All write operations are open.
     * @path /appointments/{appointmentId}
     * @allow (get, list): Any user can read appointment information.
     * @allow (create, update, delete): Any authenticated user can create, update, or delete appointments.
     * @deny (create, update, delete): Not applicable, as write operations are open in prototype.
     * @principle Allows any user to read appointments information.
     */
    match /appointments/{appointmentId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}