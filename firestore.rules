/**
 * @fileOverview Firestore Security Rules for Gopalganj Swasthya Seva app.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure access to doctor profiles and appointment data, with simple and clear authorization logic.
 * It adopts a role-based access control, primarily focusing on authenticated users. Data validation is minimized for rapid prototyping.
 *
 * Data Structure:
 * - /doctors/{doctorId}: Stores public doctor profile information.
 * - /appointments/{appointmentId}: Stores appointment data.
 *
 * Key Security Decisions:
 * - Doctors collection is publicly readable, but only authorized users can create, update, or delete doctor profiles (TODO: Define authorized users and roles).
 * - Appointments collection requires user authentication for all operations.
 *
 * Denormalization for Authorization: N/A
 *
 * Structural Segregation: Doctor profiles and appointment data are kept in separate top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read access to all doctor profiles, but restricts write access.
     * @path /databases/{database}/documents/doctors/{doctorId}
     * @allow get, list: All users can read doctor profiles.
     * @allow create: if false; // TODO: Only allow authorized users to create.
     * @allow update: if false; // TODO: Only allow authorized users to update.
     * @allow delete: if false; // TODO: Only allow authorized users to delete.
     * @principle Public read, restricted write.
     */
    match /doctors/{doctorId} {
      allow get, list: if true;
      allow create: if false; // TODO: Add role-based authorization for doctor creation.
      allow update: if false; // TODO: Add role-based authorization for doctor updates.
      allow delete: if false; // TODO: Add role-based authorization for doctor deletion.
    }

    /**
     * @description Controls access to appointment data. Only authenticated users can create, read, update, or delete appointments.
     * @path /databases/{database}/documents/appointments/{appointmentId}
     * @allow create: Authenticated users can create appointments.
     * @allow get: Authenticated users can read their own appointments.
     * @allow list: Authenticated users can list their own appointments.
     * @allow update: Authenticated users can update their own appointments.
     * @allow delete: Authenticated users can delete their own appointments.
     * @deny create: Non-authenticated users cannot create appointments.
     * @deny get: Non-authenticated users cannot read appointment data.
     * @deny list: Non-authenticated users cannot list appointment data.
     * @deny update: Non-authenticated users cannot update appointment data.
     * @deny delete: Non-authenticated users cannot delete appointment data.
     * @principle Authenticated user access only.
     */
    match /appointments/{appointmentId} {
      allow create: if isSignedIn();
      allow get, list: if isSignedIn(); // TODO: Refine to only allow access to relevant appointments (e.g., owned by the user or related to the user).
      allow update: if isSignedIn() && resource != null; // TODO: Refine to only allow access to relevant appointments (e.g., owned by the user or related to the user).
      allow delete: if isSignedIn() && resource != null; // TODO: Refine to only allow access to relevant appointments (e.g., owned by the user or related to the user).
    }
  }

  // Helper function to check if the user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }
}