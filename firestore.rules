/**
 * @fileoverview Firestore Security Rules for the Gopalganj Swasthya Seva app.
 *
 * Core Philosophy:
 * This ruleset prioritizes a straightforward, flat data structure and aims for simplicity and security in access control.
 * Doctors profiles are publicly readable, while appointments are accessible to all signed in users.
 *
 * Data Structure:
 * - /doctors/{doctorId}: Stores public doctor profile information.
 * - /appointments/{appointmentId}: Stores appointment details, accessible to any signed in user.
 *
 * Key Security Decisions:
 * - Doctor profiles are publicly readable to facilitate easy discovery.
 * - Appointments are readable and writeable by all signed-in users, as authorization will be handled by the application.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Doctor profiles are publicly readable. Anyone can view doctor information.
     * @path /doctors/{doctorId}
     * @allow get: Anyone can read a doctor's profile.
     * @allow list: Anyone can list doctors.
     * @deny create: Nobody can create doctor profiles directly through Firestore. Use backend functions.
     * @deny update: Nobody can update doctor profiles directly through Firestore. Use backend functions.
     * @deny delete: Nobody can delete doctor profiles directly through Firestore. Use backend functions.
     * @principle Doctor profiles are public; writes are restricted.
     */
    match /doctors/{doctorId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Appointments are readable and writeable by all signed-in users, as authorization will be handled by the application.
     * @path /appointments/{appointmentId}
     * @allow get: Any signed-in user can get an appointment.
     * @allow list: Any signed-in user can list appointments.
     * @allow create: Any signed-in user can create an appointment.
     * @allow update: Any signed-in user can update an appointment.
     * @allow delete: Any signed-in user can delete an appointment.
     * @principle Any signed-in user can read and write appointment data.
     */
    match /appointments/{appointmentId} {
        allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}