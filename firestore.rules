/**
 * @fileoverview Firestore Security Rules for the Gopalganj Swasthya Seva app.
 *
 * Core Philosophy:
 * This ruleset prioritizes data security and access control.
 * Doctors are publicly accessible, while appointments are only accessible to authenticated users.
 *
 * Data Structure:
 * - /doctors/{doctorId}: Stores doctor profiles.
 * - /appointments/{appointmentId}: Stores appointment information.
 *
 * Key Security Decisions:
 * - Doctors are publicly readable but only writeable by an admin (not implemented in this version).
 * - Appointments can be created by any authenticated user, but read access is not explicitly granted.
 *   - This means that a client can create an appointment, but cannot view or list any appointments.
 *   - This may change in future versions after discussing the desired access pattern (e.g. patients view their own appointments, doctors view their appointments).
 * - No user listing is allowed (explicitly denied).
 *
 * Denormalization for Authorization:
 *   - Not applicable in the current ruleset, as no complex authorization logic requiring denormalization is present.
 *   - If appointment access needs to be restricted to the patient and the doctor in the future,
 *     the appointment document should include the patient's UID.
 *
 * Structural Segregation:
 *   - Doctor profiles and appointment data are stored in separate top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Doctors are publicly readable. Writes are not allowed in this version.
     * @path /doctors/{doctorId}
     * @allow get, list: Anyone can read doctor profiles.
     * @deny create, update, delete: No one can create, update, or delete doctor profiles.
     * @principle Public read, owner-only writes (currently disabled).
     */
    match /doctors/{doctorId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Appointments can be created by any authenticated user.
     *              Other access patterns (e.g. read, list) may be added in the future after discussion.
     * @path /appointments/{appointmentId}
     * @allow create: Authenticated users can create appointments.
     * @deny get, list, update, delete: No one can get, list, update, or delete appointments in the current version.
     * @principle Authenticated users can create appointments.
     */
    match /appointments/{appointmentId} {
      allow create: if isSignedIn();
      allow get, list, update, delete: if false;
    }

    /**
     * isSignedIn() - Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}