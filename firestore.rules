/**
 * @fileoverview Firestore Security Rules for the Gopalganj Swasthya Seva app.
 *
 * Core Philosophy:
 * This ruleset provides basic read and write access control for doctors and appointments.
 * All data access requires authentication. Read access to doctor profiles is public.
 * Write access for all data is restricted and requires authentication.
 *
 * Data Structure:
 * - /doctors/{doctorId}: Stores doctor profiles.
 * - /appointments/{appointmentId}: Stores appointment information.
 *
 * Key Security Decisions:
 * - Public read access to the `doctors` collection to display doctor information.
 * - Authenticated write access to the `appointments` collection to enable booking.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to doctor profiles and restricts write access to authenticated users.
     * @path /doctors/{doctorId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Allows anyone to view doctor profiles, but only authenticated users can create, update, or delete them.
     */
    match /doctors/{doctorId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to manage appointments.
     * @path /appointments/{appointmentId}
     * @allow get, list: if isSignedIn();
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Restricts access to appointments to authenticated users only.
     */
    match /appointments/{appointmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Helper function to check if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}