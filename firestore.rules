/**
 * @fileoverview Firestore Security Rules for the Gopalganj Swasthya Seva app.
 *
 * Core Philosophy:
 * This ruleset prioritizes a flexible data model while strictly controlling data access.
 * It allows any authenticated user to create doctors and appointments (Self-Creation),
 * but restricts modifications to doctors and appointments to authenticated users only (Verified Identity).
 *
 * Data Structure:
 * - `/doctors/{doctorId}`: Stores doctor profiles.
 * - `/appointments/{appointmentId}`: Stores appointment data.
 *
 * Key Security Decisions:
 * - Data validation is minimal to enable rapid prototyping.
 * - Public listing is enabled for doctors and appointments.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to doctor profiles, allows any authenticated user to create doctor profiles, but restricts modifications to doctors to authenticated users only.
     * @path /doctors/{doctorId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny get: if false;
     * @deny list: if false;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read with owner-only writes.
     */
    match /doctors/{doctorId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants public read access to appointments, allows any authenticated user to create appointments, but restricts modifications to appointments to authenticated users only.
     * @path /appointments/{appointmentId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny get: if false;
     * @deny list: if false;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read with owner-only writes.
     */
    match /appointments/{appointmentId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }


    function isSignedIn() {
      return request.auth != null;
    }
  }
}